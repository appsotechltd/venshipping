# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# Postgres
DATABASE_URL=postgres://ven:ven@localhost:5432/venshipping

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Customer IDs: FWB2423-0001, FWB2423-0002, ...
CUSTOMER_CODE=FWB2423
COMPANY_NAME=VEN SHIPPING
CUSTOMER_ID_PADDING=4

# Email. Leave SMTP_HOST empty in development to log emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VEN Shipping <no-reply@venshipping.com>"
# Receives a notification each time a customer registers (comma-separate for several)
ADMIN_NOTIFICATION_EMAIL=admin@venshipping.com
# Shown in emails and instructions for customers who need help
SUPPORT_EMAIL=support@venshipping.com
SUPPORT_PHONE=

# China warehouse addresses (air / sea). Edit this file with the real addresses.
WAREHOUSES_FILE=config/warehouses.json
