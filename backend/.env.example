# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# Postgres
DATABASE_URL=postgres://ven:ven@localhost:5432/venshipping

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Customer IDs: FWB2423-0001, FWB2423-0002, ...
CUSTOMER_CODE=FWB2423
COMPANY_NAME=VEN SHIPPING
CUSTOMER_ID_PADDING=4

# Email. Leave SMTP_HOST empty in development to log emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VEN Shipping <no-reply@venshipping.com>"
# Receives a notification each time a customer registers (comma-separate for several)
ADMIN_NOTIFICATION_EMAIL=admin@venshipping.com
# Shown in emails and instructions for customers who need help
SUPPORT_EMAIL=support@venshipping.com
SUPPORT_PHONE=
# Optional: link for the "Open the VEN Shipping app" button in emails (app store page or web app)
APP_URL=
# Optional: hosted logo URL for emails. Leave empty to embed the logo in each email.
EMAIL_LOGO_URL=
# How long a forgot-password code stays valid
PASSWORD_RESET_TTL_MINUTES=30

# Staff access to /api/admin (send as the X-Admin-Key header). Use a long random string.
ADMIN_API_KEY=

# Staff access to /api/admin (send as the X-Admin-Key header). Use a long random string.
ADMIN_API_KEY=

# China warehouse addresses (air / sea). Edit this file with the real addresses.
WAREHOUSES_FILE=config/warehouses.json

# Invoice currency, company details and how customers pay. Edit this file with the real details.
BILLING_FILE=config/billing.json

# Website admin login. Used once, to create the first admin account when none exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
# Public website address, used in QR codes on shipment installments
WEB_URL=https://venshipping.com
# Currency for invoices created from the website
WEB_CURRENCY=NGN
